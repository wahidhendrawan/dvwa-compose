# Copy this file to .env and REPLACE every placeholder before starting DVWA.
# `.env` is gitignored; never commit real credentials.
#
# Generate strong values, e.g.:
#   openssl rand -base64 24
#
# WARNING: DVWA is intentionally vulnerable. Bind only to loopback (default)
# and never expose it to the internet or an untrusted LAN.

# --- Required: database credentials ------------------------------------------
MYSQL_ROOT_PASSWORD=replace-with-a-unique-mariadb-root-password
DVWA_DB_USER=dvwa
DVWA_DB_PASSWORD=replace-with-a-unique-dvwa-database-password

# --- Optional: database name (defaults to `dvwa`) ----------------------------
DVWA_DB_NAME=dvwa

# --- Optional: DVWA security difficulty --------------------------------------
# Options: impossible (default), high, medium, low
DVWA_DIFFICULTY=impossible

# --- Optional: host bind address and port ------------------------------------
# Defaults keep Nginx on loopback. Change ONLY on an isolated lab network,
# and never bind to 0.0.0.0 on a machine reachable from the internet.
DVWA_BIND_ADDR=127.0.0.1
DVWA_PORT=443

# --- Optional: Wazuh agent target (used only with docker-compose.wazuh.yml) --
WAZUH_MANAGER=wazuh.manager.local
